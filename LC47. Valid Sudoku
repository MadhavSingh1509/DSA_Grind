class Solution {
public:
bool isvalid(vector<vector<char>>&board,int i,int j,char x){
for(int k=0;k<9;k++){if(board[i][k]==x||board[k][j]==x)return false;
int boxrow=3*(i/3)+k/3;
int boxcol=3*(j/3)+k%3;
if(board[boxrow][boxcol]==x)return false;
}

return true;
}
bool f(vector<vector<char>>&board){
    for(int i=0;i<9;i++){
        for(int j=0;j<9;j++){ if(board[i][j]=='.'){for(char x='1';x<='9';x++)
            {if(isvalid(board,i,j,x)){board[i][j]=x;
           if(f(board))return true;
           board[i][j]='.';

            }   }
            return false;
        }  }
    }
    return true;
}
    void solveSudoku(vector<vector<char>>& board) {
         f(board);
    }
};
